# Writes the build time into a generated source file. Run by the build_stamp target on EVERY
# build, so the stamp names the build that was linked. __DATE__/__TIME__ only changed when the
# one file using them was recompiled, so a firmware whose fix lived in another file still
# reported the old time (seen 2026-11-08: HELLO said 23:47:05 for an image linked at 23:54).
# The file is rewritten on every build, so the firmware is relinked every time; that is intended.
string(TIMESTAMP STAMP "%Y-%m-%d %H:%M:%S")
set(TEXT "// Generated by cmake/build_stamp.cmake on every build. Do not edit.\nextern const char RC422DEV_BUILD_STAMP[];\nconst char RC422DEV_BUILD_STAMP[] = \"${STAMP}\";\n")
file(WRITE "${OUT}" "${TEXT}")
