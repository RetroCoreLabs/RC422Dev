; MIT License
; This program transmits 8 bits of synchronous data, outputting each bit on a rising clock edge from a PWM pin.

.program sync_tx
.side_set 1 opt
    pull block    side 1    ; Pull data into OSR, prepare for transmission with clock high
    set x, 7      side 1    ; Preload bit counter, start bit (clock stays low for setup)

bitloop:
    out pins, 1   side 0 [7]   ; Output bit 1 clock cycle before we raise the TX CLOCK
    nop           side 0 [7]   ; wait 5 clocks more, clock going low
    

    nop           side 1 [7]   ; wait 5 clocks more, clock going high
    nop           side 1 [6]   ; wait 5 clocks more, clock still high
        
    jmp x-- bitloop side 1 [1] ; Loop back, putting clock low before next bit    
.wrap


% c-sdk {
// Initialization function for synchronous send program

static inline void sdlc_tx_program_init(PIO pio, uint sm, uint offset, uint pin_tx, uint pin_clock, uint bps) 
{
    panic("NOT USED");

    pio_sm_set_pins_with_mask(pio, sm, (1u << pin_tx) | (1u << pin_clock), (1u << pin_tx) | (1u << pin_clock));
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << pin_tx) | (1u << pin_clock), (1u << pin_tx) | (1u << pin_clock));

    pio_gpio_init(pio, pin_tx);
    pio_gpio_init(pio, pin_clock);

    pio_sm_config c = sync_tx_program_get_default_config(offset);

    // Set the 'out' shift direction to right (LSB first), no autopull, and use 8 bits to shift out
    sm_config_set_out_shift(&c, true, false, 8);

    // Configure TX and Clock pins. OUT uses pin_tx, side-set uses pin_clock
    sm_config_set_out_pins(&c, pin_tx, 1);     
    sm_config_set_sideset_pins(&c, pin_clock);

    // Join the TX FIFO to send data
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    // Set the clock divider based on bps

    uint32_t clock_hz = clock_get_hz(clk_sys); // Get the system clock frequency
    printf("System clock frequency: %u Hz\n", clock_hz);    
    
    float div = (float)clock_hz / (bps*33);   // Valudeded with logic analyzer for speed 19200
    printf("Clock divider set to: %f\n", div); // Debug line to print the clock divider
    sm_config_set_clkdiv(&c, div);
    
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void sdlc_tx_program_write(PIO pio, uint sm, uint8_t c) {
    pio_sm_put_blocking(pio, sm, (uint32_t)c);
}

static inline void sync_tx_program_putc(PIO pio, uint sm, char c) {
    pio_sm_put_blocking(pio, sm, (uint32_t)c);
}

static inline void sync_tx_program_puts(PIO pio, uint sm, const char *s) {
    while (*s)
        sync_tx_program_putc(pio, sm, *s++);
}

%}


.program sync_tx_with_count
.side_set 1 opt
    pull block      side 1        ; Pull 16-bit data into OSR, prepare for transmission with clock high
    out x, 8        side 1        ; Extract LSB from OSR into x (bit count)
bitloop:
    out pins, 1   side 0 [7]   ; Output bit 1 clock cycle before we raise the TX CLOCK
    nop           side 0 [7]   ; wait 5 clocks more, clock going low
    

    nop           side 1 [7]   ; wait 5 clocks more, clock going high
    nop           side 1 [6]   ; wait 5 clocks more, clock still high
        
    jmp x-- bitloop side 1 [1] ; Loop back, putting clock low before next bit    
.wrap


% c-sdk {
// Initialization function for synchronous send program

static inline void sdlc_tx_with_count_program_init(PIO pio, uint sm, uint offset, uint pin_tx, uint pin_clock, uint bps) 
{

    pio_sm_set_pins_with_mask(pio, sm, (1u << pin_tx) | (1u << pin_clock), (1u << pin_tx) | (1u << pin_clock));
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << pin_tx) | (1u << pin_clock), (1u << pin_tx) | (1u << pin_clock));

    pio_gpio_init(pio, pin_tx);
    pio_gpio_init(pio, pin_clock);

    pio_sm_config c = sync_tx_with_count_program_get_default_config(offset);

    // Set the 'out' shift direction to right (LSB first), no autopull, and use 8 bits to shift out
    sm_config_set_out_shift(&c, true, false, 24);

    // Configure TX and Clock pins. OUT uses pin_tx, side-set uses pin_clock
    sm_config_set_out_pins(&c, pin_tx, 1);     
    sm_config_set_sideset_pins(&c, pin_clock);

    // Join the TX FIFO to send data
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    // Set the clock divider based on bps

    uint32_t clock_hz = clock_get_hz(clk_sys); // Get the system clock frequency
    printf("System clock frequency: %u Hz\n", clock_hz);    
    
    float div = (float)clock_hz / (bps*33);   // Valudeded with logic analyzer for speed 19200
    printf("Clock divider set to: %f\n", div); // Debug line to print the clock divider
    sm_config_set_clkdiv(&c, div);
    
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void sdlc_tx_program_write_cnt(PIO pio, uint sm,  uint16_t c, uint8_t bit_cnt) {
    pio_sm_put_blocking(pio, sm, (uint32_t)c<<8 | bit_cnt);
}

%}


.program sync_rx_8_hdlc
.wrap_target        
sync_hunt:
    ;jmp data_loop;

    wait 0 pin 1                ; Wait for clock to go low
    wait 1 pin 1                ; Wait for clock (pin 0) to go high
            
    in pins, 1                  ; Read data pin (pin 1), expecting a '0' to start sync    
    jmp pin sync_hunt           ; If data pin is '1', keep searching for sync pattern    

    ; Now expect 6 consecutive '1's
    set y, 5                    ; Reset y to 5 to count six consecutive '1's    

check_ones:
    wait 0 pin 1                ; Wait for clock to go low
    wait 1 pin 1                ; Wait for clock to go high
    
    
    in pins, 1                  ; Shift in 1 bit from data pin    
    jmp pin one_detected        ; If data pin is '1', continue counting ones    
    jmp sync_hunt               ; If data pin is '0', restart sync detection
    
one_detected:
    jmp y-- check_ones          ; Decrement y; if y is not 0, continue checking 1's


    ; Confirm the final '0' in the sync byte
    wait 0 pin 1                
    wait 1 pin 1                
    in pins, 1                  
    jmp pin sync_hunt          ; If data pin is '1', transition to sync hunting

                                ; otherwhise, it must have been 0. Found SYNC

    push noblock                ; push this complete SYNC character
    
    ; Sync pattern detected successfully, proceed to data reception
data_loop:
    set x, 7                    ; Reset x to 7 for counting 8-bit data reads        
    
loop:            
    wait 0 pin 1            ; Wait for clock to go to low        
    wait 1 pin 1            ; Wait for rising edge on the configured clock pin                

    in pins, 1              ; Shift in 1 bit from data pin to ISR (should be a Zero here..)    
    jmp x-- loop            ; Repeat until x reaches 0 (8 bits received)   
    push noblock            ; Push ISR content (8 bits) to FIFO

        
    jmp data_loop           ; If y < 6, continue receiving next bytes
.wrap




% c-sdk {

bool rx_shift_right = true;

void sdlc_rx_hdlc_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clock_pin)
{
    printf("Init HDLC RX on pin %d, RX_CLOCK on pin %d\r\n", data_pin, clock_pin);
    // Initialize data and clock pins
    //gpio_pull_up(data_pin);
    //gpio_pull_up(clock_pin);

    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_pin);

    // Set data pin as input
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, false);


    // Configure the PIO program
    pio_sm_config c = sync_rx_8_hdlc_program_get_default_config(offset);


    // Map logical pin 0 to data_pin and logical pin 1 to clock_pin
    sm_config_set_in_pins(&c, data_pin);    // Sets logical pin 0 to `data_pin`
                                            // Logical pin 1 will automatically be `clock_pin`

    // Set the data pin for conditional jump instructions
    sm_config_set_jmp_pin(&c, data_pin); 
    //sm_config_set_jmp_pin(&c, clock_pin); 

    // 8 bits - shift right  (...or left)
    sm_config_set_in_shift(&c, rx_shift_right, false, 8);    // Shift in LSB-first, 8 bits at a time

    // Bypass input synchronizer for faster response on data and clock pins
    //hw_set_bits(&pio->input_sync_bypass, (1u << data_pin) | (1u << clock_pin));    
    
    // Initialize and enable state machine
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

